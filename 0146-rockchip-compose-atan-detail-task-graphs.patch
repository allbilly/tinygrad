+  neg_source = graph.op(zero, source_arg, Ops.SUB, repeat=False)
+  abs_source = graph.op(source_arg, neg_source, Ops.MAX, repeat=False)
+  negative = graph.positive_mask(zero, source_arg, repeat=True)
+  nonnegative = graph.op(one, negative, Ops.SUB, repeat=False)
+  large = graph.positive_mask(abs_source, one, repeat=True)
+  small = graph.op(one, large, Ops.SUB, repeat=False)
+  # Adding one only to the unused |x|<=1 denominator avoids 1/0.
+  safe_denominator = graph.op(abs_source, small, Ops.ADD, repeat=False)
+  inverse = graph.op(one, safe_denominator, Ops.FDIV, repeat=False)
+  small_input = graph.op(abs_source, small, Ops.MUL, repeat=False)
+  large_input = graph.op(inverse, large, Ops.MUL, repeat=False)
+  transformed = graph.op(small_input, large_input, Ops.ADD, repeat=False)
+
+  near_outside = graph.positive_mask(transformed, _float_arg(.04), repeat=True)
+  near_inside = graph.op(one, near_outside, Ops.SUB, repeat=False)
+  local_outside = graph.positive_mask(transformed, _float_arg(.125), repeat=True)
+  local_inside = graph.op(one, local_outside, Ops.SUB, repeat=False)
+  local_mask = graph.op(local_inside, near_inside, Ops.SUB, repeat=False)
+  negative_transformed = graph.op(zero, transformed, Ops.SUB, repeat=False)
+  amplified_negative = graph.op(negative_transformed, _float_arg(4), Ops.MUL, repeat=False)
+  local_small = graph.op(local_inside, small, Ops.MUL, repeat=False)
+  local_coordinate = graph.op(amplified_negative, local_small, Ops.MUL, repeat=False)
+  large_coordinate = graph.op(transformed, large, Ops.MUL, repeat=False)
+  detail_input = graph.op(local_coordinate, large_coordinate, Ops.ADD, repeat=False)
+  broad_slot, local_slot = graph.alloc(), graph.alloc()
+  if not graph.emit_named_lut("rk_atan", transformed[0], broad_slot) or \
+     not graph.emit_named_lut("rk_atan_local", detail_input[0], local_slot): return None
+  broad_region = graph.op(local_outside, small, Ops.MUL, repeat=False)
+  local_region = graph.op(local_mask, small, Ops.MUL, repeat=False)
+  near_region = graph.op(near_inside, small, Ops.MUL, repeat=False)
+  broad_selected = graph.op((broad_slot,0), broad_region, Ops.MUL, repeat=False)
+  local_scaled = graph.op((local_slot,0), _float_arg(.25), Ops.MUL, repeat=False)
+  local_selected = graph.op(local_scaled, local_region, Ops.MUL, repeat=False)
+  near_selected = graph.op(transformed, near_region, Ops.MUL, repeat=False)
+  large_scaled = graph.op((local_slot,0), _float_arg(2), Ops.MUL, repeat=False)
+  large_selected = graph.op(large_scaled, large, Ops.MUL, repeat=False)
+  magnitude = graph.op(graph.op(graph.op(broad_selected, local_selected, Ops.ADD, repeat=False), near_selected, Ops.ADD, repeat=False),
+                       large_selected, Ops.ADD, repeat=False)
+  negative_magnitude = graph.op(zero, magnitude, Ops.SUB, repeat=False)
+  positive_selected = graph.op(magnitude, nonnegative, Ops.MUL, repeat=False)
+  negative_selected = graph.op(negative_magnitude, negative, Ops.MUL, repeat=False)
+  graph.op(positive_selected, negative_selected, Ops.ADD, out_slot=out, repeat=False)
+  return tuple(graph.tasks)
 
