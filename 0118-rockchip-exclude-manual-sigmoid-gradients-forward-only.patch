From 136d8b88136529c39db6bf80223187d5f817dbbb Mon Sep 17 00:00:00 2001
From: allbilly <53866088+allbilly@users.noreply.github.com>
Date: Fri, 31 Jul 2026 17:54:42 +0800
Subject: [PATCH] rockchip: exclude manual sigmoid gradients forward-only

---
 test/rockchip/conftest_rockchip.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/test/rockchip/conftest_rockchip.py b/test/rockchip/conftest_rockchip.py
index 0cb0b33ec..ed15a23b4 100644
--- a/test/rockchip/conftest_rockchip.py
+++ b/test/rockchip/conftest_rockchip.py
@@ -30,7 +30,8 @@ from tinygrad import dtypes
 def pytest_collection_modifyitems(items):
   """Exclude manual backward-only methods from the forward contract."""
   if os.environ.get("FORWARD_ONLY") != "1": return
-  backward_only = {"test_cmp_ne_backwards", "test_cmp_lt_backwards", "test_pow_const_direct"}
+  backward_only = {"test_cmp_ne_backwards", "test_cmp_lt_backwards", "test_pow_const_direct",
+                   "test_sigmoid_extreme", "test_sigmoid_alt_extreme"}
   for item in items:
     if item.path.name == "test_ops.py" and item.name in backward_only:
       item.add_marker(pytest.mark.skip(reason="ROCKCHIP forward-only contract excludes manual gradient tests"))
