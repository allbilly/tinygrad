-    cmds, task, relocs = emit_rk(plan)
-    tasks.append(RKSubTask(cmds, task, relocs))
-    return True
+  graph = _TaskGraph(sink, store, source)
+  total, out, tasks, alloc = graph.total, graph.out, graph.tasks, graph.alloc
+  add_lut = graph.emit_named_lut
 
