-                       {float(v.arg) for v in u.toposort() if v.op is Ops.CONST and isinstance(v.arg, (float, np.floating))} >= {0.0, 1.0}]
-  if not target_candidates: return None
-  target = max(target_candidates, key=lambda u:len(u.toposort()))
