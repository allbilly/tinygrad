+  assert tag == _CMAC_MATERIALIZED_LAYOUT
+  cursor = 0
+  n_loops = meta[cursor]
+  loop_extents = meta[cursor+1:cursor+1+n_loops]
+  cursor += n_loops+1
+  n_reductions = meta[cursor]
+  reduce_extents = meta[cursor+1:cursor+1+n_reductions]
+  cursor += n_reductions+1
+  n_m_axes = meta[cursor]
