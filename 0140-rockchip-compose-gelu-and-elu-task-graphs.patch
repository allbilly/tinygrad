+  local = graph.alloc()
+  if not graph.emit_named_lut(("rk_gelu_local", approximate_tanh), zoomed[0], local): return None
+
+  range_outside, range_inside = graph.interval_mask(source_arg, -4.0, 4.0, repeat=False)
+  _, local_inside = graph.interval_mask(source_arg, -0.5, 0.5, repeat=False)
+  _, poly_inside = graph.interval_mask(source_arg, -0.04, 0.04, repeat=False)
+  local_mask = graph.op(local_inside, poly_inside, Ops.SUB, repeat=False)
+  broad_mask = graph.op(range_inside, local_inside, Ops.SUB, repeat=False)
+
+  poly_input = graph.clamp_symmetric(source_arg, 0.04)
+  linear = graph.op(poly_input, _float_arg(0.5), Ops.MUL, repeat=False)
+  square = graph.op(poly_input, poly_input, Ops.MUL, repeat=False)
+  quadratic = graph.op(square, _float_arg(1/math.sqrt(2*math.pi)), Ops.MUL, repeat=False)
+  polynomial = graph.op(linear, quadratic, Ops.ADD, repeat=False)
+  positive = graph.positive_mask(source_arg, zero)
+  positive_extra = graph.op(positive, _float_arg(3.0), Ops.MUL, repeat=False)
+  broad_scale = graph.op(one, positive_extra, Ops.ADD, repeat=False)
+  broad_scaled = graph.op((broad,0), broad_scale, Ops.MUL, repeat=False)
+  broad_selected = graph.op(broad_scaled, broad_mask, Ops.MUL, repeat=False)
+  local_scaled = graph.op((local,0), _float_arg(0.5), Ops.MUL, repeat=False)
+  local_selected = graph.op(local_scaled, local_mask, Ops.MUL, repeat=False)
+  poly_selected = graph.op(polynomial, poly_inside, Ops.MUL, repeat=False)
+  interior = graph.op(graph.op(broad_selected, local_selected, Ops.ADD, repeat=False), poly_selected, Ops.ADD, repeat=False)
+  fallback = graph.op(source_arg, zero, Ops.MAX, repeat=False)
+  fallback_selected = graph.op(fallback, range_outside, Ops.MUL, repeat=False)
+  graph.op(interior, fallback_selected, Ops.ADD, out_slot=graph.out, repeat=False)
+  return tuple(graph.tasks)
 
