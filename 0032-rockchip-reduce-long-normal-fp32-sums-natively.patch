                         task.task.layout[1] == _HOST_FP32_HALF_LAYOUT for task in subtasks))
     self.assertEqual(subtasks[-1].task.layout[1], _HOST_FP32_COMBINE_LAYOUT)
 
+  def test_long_fp32_sum_uses_two_level_raw_cmac(self):
