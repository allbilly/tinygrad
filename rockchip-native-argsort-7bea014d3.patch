+  flat_indexes = tuple(index for _, pair in equality_pairs for index in pair)
+  source_totals = tuple(int(x.src[0].src[0].arg) for x in flat_indexes)
+  mappings:list[tuple[tuple[tuple[int,...],...],tuple[int,...]]] = []
