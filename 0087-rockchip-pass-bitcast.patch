               Ops.XOR:13, Ops.CAST:14, Ops.TRUNC:15, Ops.SQRT:16, Ops.EXP2:17,
               Ops.LOG2:18, Ops.SIN:19, Ops.CMOD:20, Ops.CDIV:21, Ops.FLOORDIV:22,
