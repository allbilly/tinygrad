+}
+
+def _build_lut_tables(lut_op:Ops, input_scale:float) -> _LUTBuild:
+  if (static_builder := _LUT_STATIC_BUILDERS.get(lut_op)) is not None: return static_builder()
+  if (scale_builder := _LUT_SCALE_BUILDERS.get(lut_op)) is not None: return scale_builder(input_scale)
+  if (scale_bool_builder := _LUT_SCALE_BOOL_BUILDERS.get(lut_op)) is not None: return scale_bool_builder(bool(input_scale))
+  if (fixed_bool_builder := _LUT_FIXED_BOOL_BUILDERS.get(lut_op)) is not None:
+    return fixed_bool_builder[0](fixed_bool_builder[1])
+  if (region := _LUT_REGION_BUILDERS.get(lut_op)) is not None: return _build_pow_base8_lut(region)
+  raise AssertionError(f"dpu_lut: no builder for {lut_op}")
