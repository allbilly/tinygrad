+def _try_hardswish(val:UOp) -> UOp|None:
+  """Recognize tinygrad's exact HardSwish expansion and return its source INDEX."""
+  val = _unwrap(val)
+  indexes = [u for u in val.toposort() if u.op is Ops.INDEX]
+  if len(indexes) != 1 or (source := indexes[0]).dtype is not dtypes.half: return None
+  def c(value:float) -> UOp: return UOp.const(dtypes.half, value)
+  zero = c(0.0)
+  plus3 = UOp(Ops.ADD, dtypes.half, (source, c(3.0)))
+  relu_plus3 = UOp(Ops.WHERE, dtypes.half, (UOp(Ops.CMPLT, dtypes.bool, (zero, plus3)), plus3, zero))
+  minus3 = UOp(Ops.ADD, dtypes.half, (source, c(-3.0)))
+  relu_minus3 = UOp(Ops.WHERE, dtypes.half, (UOp(Ops.CMPLT, dtypes.bool, (zero, minus3)), minus3, zero))
+  clipped = UOp(Ops.ADD, dtypes.half, (relu_plus3, UOp(Ops.MUL, dtypes.half, (relu_minus3, c(-1.0)))))
+  expected = UOp(Ops.MUL, dtypes.half, (UOp(Ops.MUL, dtypes.half, (source, clipped)), c(1/6)))
+  return source if val is expected else None
