+def _build_silu_lut() -> tuple[list[int], int, float, float, int]:
+  """Build the signed SiLU table based on rknnops.h algorithm 15.
+  Tune its indexing grid to [-2, 2] and use exact power-of-two output scaling."""
+  index_scale, output_scale = 8190.0, 16384.0
+  step = 32.0 / index_scale
+  lut = [0] * _LUT_SIZE * 2
+  for i in range(_LUT_SIZE):
+    x = (_LUT_SIZE - 1 - i) * step
+    v = int(round((-x / (1.0 + math.exp(x))) * output_scale))
+    lut[i] = 1 if v == 0 else max(-32768, min(32767, v))
+  for i in range(_LUT_SIZE):
+    x = i * step
+    v = int(round((x / (1.0 + math.exp(-x))) * output_scale))
+    lut[_LUT_SIZE+i] = 1 if v == 0 else max(-32768, min(32767, v))
+  return lut, int(np.float16(index_scale).view(np.int16)) & 0xFFFF, output_scale, index_scale, 14
+
