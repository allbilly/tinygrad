+    if idx.op is Ops.INDEX and _try_sigmoid(sigmoid) == idx.src[0].buf_uop.arg.slot and \
+       all(u is idx for u in val.src[1].toposort() if u.op is Ops.INDEX):
+      return idx.src[0].buf_uop.arg.slot
+    return None
+  if val.op is not Ops.MUL: return None
+  for idx, sigmoid in ((val.src[0], val.src[1]), (val.src[1], val.src[0])):
