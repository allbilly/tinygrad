diff --git a/lut.md b/lut.md
index c0b46c01a..0ff2f56f7 100644
--- a/lut.md
+++ b/lut.md
@@ -244,0 +245,6 @@ arithmetic selection stages.
+QuickGELU, `x*sigmoid(1.702*x)`, uses asymmetric tails: the positive asymptote
+is `x`, while the negative asymptote is zero. Its NPU epilogue therefore keeps
+the staged interior, selects `x` above 5, and selects zero below -10. Do not use
+a symmetric threshold here: at `x=-5.5` the true result is still about
+`-4.7e-4`, well outside the absolute tolerance for a zero replacement.
+
diff --git a/test/rockchip/test_hw.py b/test/rockchip/test_hw.py
index fb539faee..5e107477d 100644
--- a/test/rockchip/test_hw.py
+++ b/test/rockchip/test_hw.py
@@ -228,0 +229,7 @@ class TestDPU(unittest.TestCase):
+  def test_dpu_quick_gelu_extreme_saturation(self):
+    a_np = np.array([-400, -300, -10.5, 5.5, 300, 400], dtype=np.float16)
+    with np.errstate(over="ignore"):
+      expected = (a_np.astype(np.float32) / (1 + np.exp(-1.702*a_np.astype(np.float32)))).astype(np.float16)
+    actual = Tensor(a_np, device="ROCKCHIP").quick_gelu().realize().numpy()
+    np.testing.assert_allclose(actual, expected, rtol=1e-3, atol=1e-6)
+
