+    fine_mask = graph.op(one, coarse_mask, Ops.SUB, repeat=False)
+    coarse_selected = graph.op((coarse_slot,0), coarse_mask, Ops.MUL, repeat=False)
+    fine_selected = graph.op(decoded_fine, fine_mask, Ops.MUL, repeat=False)
+    return graph.op(coarse_selected, fine_selected, Ops.ADD, repeat=False)
 
