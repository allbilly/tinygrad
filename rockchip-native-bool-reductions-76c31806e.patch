+      result_layout = (count, _HOST_MOVEMENT_LAYOUT, 2, 1, count,
+                       2, 1, 0,
+                       4, 1, 0, 10, 0)
+      result_relocs = (RKReloc(0, counted, 0, 0, 0xFFFFFFFF),
